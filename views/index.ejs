<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="style.css">
    <title>Document</title>
</head>
<body>
    <header class="header">
        <div class="header-content">
            <% if(locals.m){ %>
                <%= m %>
            <% }else{ %>
                <h1 class="site-title">Welcome to My Blog</h1>
            <% } %>
        </div>
    </header>
    
    <main class="main-content">
        <section class="posts">
            <ul>
                <% s.forEach(elem => { %>
                    <li class="post-item">
                        <a href="#" class="post-link">
                            <div class="post-info">
                                <h3 class="post-title">ID: <%= elem.id %></h3>
                                <p class="post-meta">Title: <%= elem.title %></p>
                                <p class="post-meta">Writer: <%= elem.writer %></p>
                            </div>
                        </a>
                    </li>
                <% }) %>
            </ul>
        </section>

        <section class="create-blog">
            <form action="" method="get">
                <button type="submit" class="create-blog-button" formaction="/post-blog">Create a Blog</button>
            </form>
        </section>
    </main>

    <script src="script.js"></script>
</body>
</html>
