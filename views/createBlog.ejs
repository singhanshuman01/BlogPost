<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="create-page-style.css">
    <title>Document</title>
</head>
<body>
    <form action="/post-blog" method="post">
        <h1>Create a Blog Post</h1>
        
        <label for="id">ID:</label>
        <input type="text" name="id" id="id" required>

        <label for="title">Title:</label>
        <input type="text" name="title" id="title" required>

        <label for="writer">Writer:</label>
        <input type="text" name="writer" id="writer" required>

        <label for="blog">Blog Content:</label>
        <textarea name="blog" id="blog" required></textarea>

        <input type="submit" value="Post">
    </form>
</body>
</html>
